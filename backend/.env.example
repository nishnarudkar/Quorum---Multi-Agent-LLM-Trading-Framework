# ─── Required ─────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ─── LLM Models (optional — defaults shown) ───────────────────
# Any chat model your Groq account lists at https://console.groq.com/docs/models
DEEP_THINK_MODEL=openai/gpt-oss-120b
QUICK_THINK_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3
LLM_TIMEOUT=120
LLM_CONCURRENCY=3

# ─── Pipeline (optional — defaults shown) ─────────────────────
MAX_DEBATE_ROUNDS=2
MAX_RISK_DEBATE_ROUNDS=2
ANALYST_TIMEOUT=60
PIPELINE_TIMEOUT=600
AUTO_TRADE_CONFIDENCE=0.85
ENABLE_HITL=true

# ─── Position Sizing ──────────────────────────────────────────
MAX_POSITION_SIZE=0.25
MIN_POSITION_SIZE=0.01
INITIAL_CAPITAL=100000.0

# ─── Data Cache ───────────────────────────────────────────────
DATA_CACHE_TTL=300

# ─── Real-Time ────────────────────────────────────────────────
PRICE_POLL_INTERVAL=15        # seconds between live price pushes over WebSocket
SCANNER_ENABLED=false         # set true to auto-analyze the watchlist on a schedule
SCAN_INTERVAL_MINUTES=60      # how often the scanner auto-analyzes the watchlist
SCAN_COOLDOWN_MINUTES=30      # minimum gap between analyses of the same ticker
ALERT_CONFIDENCE_THRESHOLD=0.65  # minimum confidence to send a Telegram/Discord alert

# ─── Alerts (optional) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
DISCORD_WEBHOOK_URL=your_webhook_url

# ─── Alpaca Market API ────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER=true

# ─── Server (optional) ────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
